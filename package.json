{
  "version": "0.1.0",
  "license": "MIT",
  "name": "reactivity-store-project",
  "author": "MrWangJustToDo",
  "engines": {
    "node": ">=10"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:packages": "ts-node ./scripts/rollupWatch.ts",
    "build:packages": "ts-node ./scripts/rollupBuild.ts",
    "build:type-gen": "cd packages/r-store && pnpm run type-gen",
    "build:type-copy": "ts-node ./scripts/clearTemp.ts",
    "build:type": "pnpm run build:type-gen && pnpm run build:type-copy",
    "build:type-octane-gen": "tsrx-tsc --project packages/r-store/tsconfig.octane.json && cd packages/r-store && pnpm exec api-extractor run --local --verbose --config api-extractor.octane.json",
    "build:type-octane-copy": "ts-node ./scripts/clearOctaneTemp.ts",
    "build:type-octane": "pnpm run build:type-octane-gen && pnpm run build:type-octane-copy",
    "typecheck:octane": "tsrx-tsc --noEmit --project packages/r-store/tsconfig.octane-tests.json",
    "build": "pnpm run build:packages && pnpm run build:type && pnpm run build:type-octane",
    "test:octane": "vitest run --config vitest.config.ts && vitest run --config vitest.ssr.config.ts",
    "test:react-build": "vitest run --config vitest.react.config.ts && node scripts/verifyReactBuild.mjs",
    "test:package": "node scripts/verifyPackage.mjs",
    "lint": "eslint --cache --ext ts,tsx .",
    "lint:fix": "pnpm run lint --fix",
    "prettier": "prettier --ignore-path .prettierignore --write .",
    "clean": "pnpm -p -r -c exec rm -rf dist dev .cache",
    "purge": "pnpm -p -r -c exec rm -rf node_modules",
    "docs:dev": "vitepress dev app --force",
    "docs:build": "vitepress build app",
    "docs:preview": "vitepress preview app"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm lint"
    }
  },
  "devDependencies": {
    "@algolia/client-search": "^4.25.2",
    "@shikijs/twoslash": "^3.23.0",
    "@shikijs/vitepress-twoslash": "^3.23.0",
    "@swc/core": "^1.10.15",
    "@tsrx/typescript-plugin": "0.3.118",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.18.10",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vue/reactivity": "~3.5.40",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "happy-dom": "^20.11.2",
    "husky": "^8.0.2",
    "lodash": "^4.17.21",
    "octane": "0.1.36",
    "prettier": "^3.6.2",
    "project-tool": "https://github.com/MrWangJustToDo/project-tool.git#bdab2efaaec614833f7ecaea80d39585a4225fe0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactivity-store": "workspaces: *",
    "search-insights": "^2.17.0",
    "shiki": "^3.23.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.16",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "zustand": "^5.0.11"
  }
}
